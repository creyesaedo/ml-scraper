generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        Int     @id @default(autoincrement())
  name      String  @db.VarChar(255)
  country   String  @db.VarChar(10)
  ml_id     String  @unique @db.VarChar(50)
  parent_id Int?

  parent   Category?  @relation("CategoryTree", fields: [parent_id], references: [id])
  children Category[] @relation("CategoryTree")

  products_as_category Product[] @relation("ProductCategory")
  products_as_parent   Product[] @relation("ProductParentCategory")

  @@index([ml_id])
  @@index([country])
  @@index([parent_id])
  @@map("categories")
}

model Product {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(500)
  price         Decimal   @db.Decimal(14, 2)
  country       String?   @db.VarChar(10)
  category_id   Int
  parent_id     Int?
  seller_id     Int?
  snapshot_date DateTime  @default(now()) @db.Timestamp()
  catalog_id    String?   @db.VarChar(50)
  date_created  DateTime?
  sold_count    Int?
  rating        Decimal?  @db.Decimal(3, 2)
  review_count  Int?
  brand         String?   @db.VarChar(255)
  holiday_name  String?   @db.VarChar(255)

  ranking_position Int?
  original_price   Decimal? @db.Decimal(14, 2)
  discount_pct     Int?
  shipping_type    String?  @db.VarChar(20)
  listing_type_id  String?  @db.VarChar(20)
  is_cbt           Boolean  @default(false)

  category        Category @relation("ProductCategory", fields: [category_id], references: [id])
  parent_category Category? @relation("ProductParentCategory", fields: [parent_id], references: [id])
  seller          Seller?   @relation(fields: [seller_id], references: [id])

  @@index([category_id])
  @@index([parent_id])
  @@index([snapshot_date])
  @@index([country, snapshot_date])
  @@index([catalog_id, snapshot_date])
  @@index([seller_id])
  @@map("products")
}

model SyncProgress {
  id              Int       @id @default(autoincrement())
  sync_run_id     String    @db.VarChar(100)
  country         String    @db.VarChar(10)
  category_ml_id  String    @db.VarChar(50)
  status          String    @db.VarChar(20)
  error_msg       String?   @db.Text
  started_at      DateTime?
  completed_at    DateTime?
  created_at      DateTime  @default(now())

  @@unique([sync_run_id, category_ml_id])
  @@index([country, status])
  @@index([sync_run_id])
  @@map("sync_progress")
}

model Seller {
  id                  Int      @id @default(autoincrement())
  ml_seller_id        String   @unique @db.VarChar(50)
  nickname            String?  @db.VarChar(255)
  is_official_store   Boolean  @default(false)
  power_seller_status String?  @db.VarChar(50)
  total_products      Int?
  total_sales         Int?
  country             String?  @db.VarChar(10)
  first_seen          DateTime @default(now())
  last_seen           DateTime @default(now())

  products Product[]

  @@index([country])
  @@index([power_seller_status])
  @@map("sellers")
}
