# ml-scraper (worker) — no database. Owns Decodo + ML API + FX/holidays.

# --- HTTP ---
PORT=8001

# --- MercadoLibre OAuth2 ---
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_BASE_URL=https://api.mercadolibre.com

# --- Decodo service ---
DECODO_API_TOKEN=
DECODO_RATE_LIMIT_PER_SEC=25 #Depends of the Decodo plan's req/s cap: Free/$19=10, $49=25, $99=50, $249=100, $499=150, $999+=200

# --- Scraper safety ---
# SCRAPER_MAX_CONCURRENT auto-sizes from DECODO_RATE_LIMIT_PER_SEC (rate × ~15s,
# Little's law) to saturate the plan rate. Leave unset; set it only to impose a
# manual hard ceiling (e.g. if 400/613 bursts appear at high concurrency).
SCRAPER_RETRY_PARTIAL_RENDER=true
SCRAPER_FAILURE_THRESHOLD=10
SCRAPER_FAILURE_DUMP_DIR=tmp/scraper-failures
