# ml-scraper (worker) — stateless. Owns Decodo + ML API + FX/holidays. NO database.
# DB / APP_MODE / scheduler vars do NOT belong here — those live in ml-service.

# --- HTTP ---
PORT=8001
# PORTFOLIO_URL=        # optional CORS allow-origin (defaults to "*")

# --- MercadoLibre OAuth2 (client_credentials) ---
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_BASE_URL=https://api.mercadolibre.com

# --- Decodo Web Scraping API ---
DECODO_API_TOKEN=
# Plan req/s cap — the ONLY concurrency knob (worker auto-sizes its pool from it).
# Free/$19=10, $49=25, $99=50, $249=100, $499=150, $999+=200
DECODO_RATE_LIMIT_PER_SEC=10
# DECODO_TRANSIENT_MAX_RETRIES=10     # retries for transient 400/5xx
# DECODO_RETRY_BACKOFF_BASE_MS=3000   # backoff base (base·2^attempt, capped 30s)
# DECODO_AVG_REQUEST_SECONDS=15       # seconds a request holds a slot (auto-concurrency calc)
# DECODO_REQUEST_TIMEOUT_MS=180000    # hard per-attempt timeout for one Decodo call (vs undici ~300s)
# DECODO_GEO_OVERRIDES=MCO:br         # per-site proxy geo (MCO's 'co' pool is broken; route via 'br'). Blank to disable

# --- Scraper safety ---
# SCRAPER_MAX_CONCURRENT auto-sizes from DECODO_RATE_LIMIT_PER_SEC (rate × ~15s,
# Little's law) to saturate the plan rate. Leave unset; set only as a hard ceiling.
# SCRAPER_MAX_CONCURRENT=
# PRODUCT_CONCURRENCY=                 # product pages in flight per category (default = pool)
SCRAPER_RETRY_PARTIAL_RENDER=true
SCRAPER_FAILURE_THRESHOLD=10
SCRAPER_FAILURE_DUMP_DIR=tmp/scraper-failures
