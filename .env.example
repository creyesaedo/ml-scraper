# --- Execution mode ---
# DEVELOPMENT → scrape only MLC + MLC1648 (~21 requests, ~$0.03 per run). Default.
# PRODUCTION  → scrape the 8 core LatAm sites with all parent categories (~5,270 requests, ~$8 per run).
# Any other value falls back to DEVELOPMENT for safety.
APP_MODE=DEVELOPMENT

# --- Database (Postgres) ---
# Runtime connection. For Neon, use the POOLED URL (host contains "-pooler").
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/market_analysis
# Direct (non-pooled) connection used only by `prisma db push` / `migrate`.
# Required when DATABASE_URL points to a pgBouncer pooler (Neon's pooled URL
# rejects DDL). Falls back to DATABASE_URL when unset.
# For Neon: same as DATABASE_URL but without "-pooler" in the host.
# DIRECT_URL=

# --- MercadoLibre OAuth2 ---
# Required to call /products/{id} and /categories/{id}.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_BASE_URL=https://api.mercadolibre.com

# --- Decodo Web Scraping API ---
# Required for scraping MercadoLibre (it enforces a JS proof-of-work challenge
# that only premium proxies + headless rendering can bypass).
DECODO_API_TOKEN=
# Plan req/s caps: Free/$19=10, $49=25, $99=50, $249=100, $499=150, $999+=200
DECODO_RATE_LIMIT_PER_SEC=10

# Hard cap on concurrent scraper requests. Prevents runaway parallelism:
# p-limit(3) categories × p-limit(8) products = up to 24 in flight, which
# exceeds the Free/$19 Decodo plan's 10 req/s ceiling.
SCRAPER_MAX_CONCURRENT=10

# Circuit breaker: after N consecutive hard failures (HTTP error, timeout,
# Decodo status 5xx/613), abort the sync, dump diagnostics to disk, and mark
# the in-flight category as 'failed' in sync_progress so it can be resumed
# later via POST /sync/resume/:siteId.
SCRAPER_FAILURE_THRESHOLD=10

# Directory (relative to cwd) where the circuit breaker writes failure dumps:
# tmp/scraper-failures/{timestamp}/{error.log, sample.html, context.json}
SCRAPER_FAILURE_DUMP_DIR=tmp/scraper-failures

# --- Scheduler ---
# In-process NestJS cron (WeeklySyncJob). Off by default — GitHub Actions is
# the scheduler in CI, and on self-hosted you may prefer OS-level cron or an
# external orchestrator. Set to "true" only if you want the Node process to
# self-schedule.
ENABLE_INTERNAL_SCHEDULER=false
# Used only when ENABLE_INTERNAL_SCHEDULER=true:
SYNC_DAY_OF_WEEK=mon
SYNC_HOUR=3

# --- Legacy / advanced overrides ---
# APP_MODE replaces SNAPSHOT_SITE_IDS and SNAPSHOT_CATEGORIES_* — those vars are
# IGNORED while APP_MODE is set to DEVELOPMENT or PRODUCTION. They remain here
# only for reference if you ever need to bypass mode-derived defaults by
# editing src/config/app.config.ts directly.
# SNAPSHOT_CATEGORY_LIMIT=2
# SNAPSHOT_CATEGORIES_MLC=MLC1574,MLC1648
