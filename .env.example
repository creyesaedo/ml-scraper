# --- Execution mode ---
APP_MODE=DEVELOPMENT

# --- Database (Postgres) ---
DATABASE_URL=
DIRECT_URL=
# --- MercadoLibre OAuth2 ---
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_BASE_URL=

# --- Decodo service ---
DECODO_API_TOKEN=
DECODO_RATE_LIMIT_PER_SEC=10 #Depends of the Decodo plan's req/s cap: Free/$19=10, $49=25, $99=50, $249=100, $499=150, $999+=200
# --- Scraper safety ---
SCRAPER_MAX_CONCURRENT=10 
SCRAPER_RETRY_PARTIAL_RENDER=true
SCRAPER_FAILURE_THRESHOLD=10
SCRAPER_FAILURE_DUMP_DIR=tmp/scraper-failures

# --- Scheduler ---
ENABLE_INTERNAL_SCHEDULER=false #In-process NestJS cron (WeeklySyncJob). Off by default — GitHub Actions is the scheduler in CI, and on self-hosted you may prefer OS-level cron or an external orchestrator. Set to "true" only if you want the Node process to self-schedule.
SYNC_DAY_OF_WEEK=mon
SYNC_HOUR=3