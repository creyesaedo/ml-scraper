DATABASE_URL=postgresql://postgres:postgres@localhost:5432/market_analysis

# MercadoLibre OAuth2 — required to call /products/{id} and /categories/{id}
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_BASE_URL=https://api.mercadolibre.com

# Decodo Web Scraping API — required for scraping MercadoLibre (it enforces a
# JS proof-of-work challenge that only premium proxies + headless rendering can
# bypass).
DECODO_API_TOKEN=
# Plan req/s caps: Free/$19=10, $49=25, $99=50, $249=100, $499=150, $999+=200
DECODO_RATE_LIMIT_PER_SEC=10

# Hard cap on concurrent scraper requests. Prevents runaway parallelism:
# p-limit(3) categories × p-limit(8) products = up to 24 in flight, which
# exceeds the Free/$19 Decodo plan's 10 req/s ceiling.
SCRAPER_MAX_CONCURRENT=10

# Circuit breaker: after N consecutive hard failures (HTTP error, timeout,
# Decodo status 5xx/613), abort the sync, dump diagnostics to disk, and mark
# the in-flight category as 'failed' in sync_progress so it can be resumed
# later via POST /sync/resume/:siteId.
SCRAPER_FAILURE_THRESHOLD=10

# Directory (relative to cwd) where the circuit breaker writes failure dumps:
# tmp/scraper-failures/{timestamp}/{error.log, sample.html, context.json}
SCRAPER_FAILURE_DUMP_DIR=tmp/scraper-failures

# Weekly snapshot settings (UTC)
# Comma-separated list of MercadoLibre site IDs to snapshot weekly.
# Categories are always synced for ALL sites via the ML API (cheap, no scraping).
# Only sites listed here get their top products scraped.
#
# Recommended default: the 8 core LatAm markets (251 parent categories total,
# ~22.8k req/mo ≈ $34/mo at the $19 Decodo tier, ~80 min per sync).
# Small markets (MBO, MCU, MCR, MEC, MGT, MHN, MNI, MPA, MPY, MRD, MSV) are
# excluded — low e-commerce volume, not worth the scraping cost.
SNAPSHOT_SITE_IDS=MLA,MLB,MLC,MLM,MCO,MPE,MLU,MLV

# --- Development knobs (leave empty/unset in production) ---
# SNAPSHOT_CATEGORY_LIMIT: only scrape the first N parent categories per site (by id ASC).
# Useful for quick smoke tests. Unset/0 → all categories.
# SNAPSHOT_CATEGORY_LIMIT=2
#
# SNAPSHOT_CATEGORIES_<SITE>: whitelist specific parent category ml_ids for that site.
# Takes precedence over SNAPSHOT_CATEGORY_LIMIT when set.
# Useful for reproducible tests against known categories.
# SNAPSHOT_CATEGORIES_MLC=MLC1574,MLC1648
# SNAPSHOT_CATEGORIES_MLA=MLA1051

SYNC_DAY_OF_WEEK=mon
SYNC_HOUR=3
