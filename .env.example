DATABASE_URL=postgresql://postgres:postgres@localhost:5432/market_analysis

# MercadoLibre OAuth2 — required to call /products/{id} and /categories/{id}
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_BASE_URL=https://api.mercadolibre.com

# Bright Data Scraping Browser — WSS endpoint for Playwright CDP connection
# Required to scrape MercadoLibre pages (they enforce a JS proof-of-work challenge)
BRIGHTDATA_SCRAPING_BROWSER_WS=wss://brd-customer-XXX-zone-YYY:PASSWORD@brd.superproxy.io:9222

# Weekly cron settings (UTC)
SYNC_SITE_ID=MLC
SYNC_DAY_OF_WEEK=mon
SYNC_HOUR=3
